# Database Settings (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=erp_flow
POSTGRES_PORT=5432

# Odoo ERP Configuration
ODOO_IMAGE=odoo:19.0
ODOO_PORT=8069
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoo_secure_db_password
ODOO_ADMIN_PASSWORD=admin_super_secret_password

# AI Server (Ollama)
OLLAMA_MODEL=gemma:2b
OLLAMA_HOST=http://llm_server:11434
OLLAMA_PORT=11435

# Temporal Orchestration
TEMPORAL_HOST=temporal:7233
TEMPORAL_PORT=7234
TEMPORAL_UI_PORT=8081

# Backend / API Settings
BACKEND_PORT=8001
LOGFIRE_TOKEN=your-logfire-token-here # Optional for OpenTelemetry tracing

# Frontend Settings
FRONTEND_PORT=3001

# Gateway Settings
GATEWAY_PORT=80
GATEWAY_SSL_PORT=443

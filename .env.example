# --- Odoo Configuration ---
# Your Odoo instance URL (Internal or External)
ODOO_URL=http://your-odoo-instance:8069
ODOO_DB=your_database
ODOO_USERNAME=admin
ODOO_PASSWORD=your_password

# --- PostgreSQL Configuration ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=erp_automation
# Temporal needs a separate DB usually or schemas
TEMPORAL_DB=temporal
TEMPORAL_VISIBILITY_DB=temporal_visibility

# --- Ollama Configuration ---
OLLAMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://ollama:11434

# --- Backend Configuration ---
BACKEND_PORT=8000
LOGFIRE_TOKEN=your_logfire_token_here

# --- Temporal Configuration ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# --- Nginx Configuration ---
# Use this for SSL/Domain setup in production
NGINX_PORT=80
